############
# Nodewave Deployment Overrides
############
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml:docker-compose.nodewave.yml

# Lock direct gateway ports to localhost; expose externally only via Caddy (80/443)
KONG_HTTP_PORT=127.0.0.1:8000
KONG_HTTPS_PORT=127.0.0.1:8443

# Replace with your deployment domain (must have an A/AAAA record pointing to this server)
SUPABASE_DOMAIN=supabase.example.com
SITE_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com
SUPABASE_PUBLIC_URL=https://supabase.example.com

# Replace with your deployment email
## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false
